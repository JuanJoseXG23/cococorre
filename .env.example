# Copia este archivo como ".env" y completa los valores con los de tu proyecto Firebase.
# Firebase Console -> ⚙️ Configuración del proyecto -> General -> Tus apps -> App web -> "SDK setup and configuration" -> Config
#
# Estos valores son PÚBLICOS por diseño (identifican tu proyecto, no dan permisos).
# La seguridad real la dan las reglas de firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
